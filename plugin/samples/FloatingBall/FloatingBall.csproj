<Project Sdk="Microsoft.NET.Sdk">

  <!--
    StarPie 社区插件：悬浮球（Floating Ball）
    ==================================================================
    它是 SDK 1.5 那条 `IHostWheelService` 的**第一个真实用户**：
    球由插件自己画（`Ui`），点球之后由宿主呼出**用户配置的**轮盘（`Wheel`）。
    这个分工是本插件存在的全部理由 —— 换在 1.5 之前，插件想做个能唤出轮盘的球，
    只能自己复刻一套假轮盘，于是外观、扇区、体积、多屏 DPI 全都会和宿主漂移。

    四条配置与另两枚示例插件保持一致，改错任何一条都会导致加载失败：

    1. TargetFramework 不得高于宿主（net8.0-windows）。
    2. ProjectReference 必须设 Private=false ——
       否则产物里多出一份 StarPie.Plugin.Abstractions.dll，
       加载时出现两份 IStarPiePlugin 类型身份，强转全部失败。
    3. 只能引用 StarPie.Plugin.Abstractions 与 BCL（含 .NET 桌面运行时自带的 WPF）。
       这里刻意**不开** UseWPF / UseWindowsForms：那两条会顺带塞进一堆构建期约定
       （XAML 编译目标、WinForms 与 WPF 的同名类型冲突），而本插件只需要
       PresentationFramework 里那几个类型 —— 直接 FrameworkReference 到 WPF 那组
       框架引用就够了，它正是 UseWPF 内部实际做的事。
    4. 不带 XAML、不引 NuGet：产物只有**一个 dll**（外加 plugin.json）。
       插件目录里每多一份依赖，ALC 卸载就多一分失败的概率。
  -->

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>12.0</LangVersion>

    <AssemblyName>StarPie.Plugin.FloatingBall</AssemblyName>
    <RootNamespace>StarPie.Plugin.FloatingBall</RootNamespace>

    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Product>StarPie 悬浮球插件</Product>
    <Company>StarPie Community</Company>
    <Description>在屏幕上放一颗常驻悬浮球，点它呼出你自己的轮盘。</Description>

    <!-- 宿主是 x64；本插件按 x64 生成 -->
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <!--
      WPF 的引用装配组。为什么不开 UseWPF：那条属性顺带带进 XAML 编译目标与一整套构建约定，
      而本插件只需要 PresentationFramework 里那几个类型；FrameworkReference 就是 UseWPF
      内部实际做的事，直接写它反而更少 surprises（产物里没有 .g.cs、没有生成 AssemblyInfo 里
      的 ThemeInfo）。Private 概念在这里不适用 —— 框架引用本来就不落地到输出目录。
    -->
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WPF" />
  </ItemGroup>

  <ItemGroup>
    <!-- Private=false 是「避免类型身份分裂」的关键，请勿删除。 -->
    <ProjectReference Include="..\..\sdk\StarPie.Plugin.Abstractions\StarPie.Plugin.Abstractions.csproj">
      <Private>false</Private>
    </ProjectReference>
  </ItemGroup>

  <!-- 程序集元数据：让「裸 DLL」分发形态也能被识别（带 plugin.json 时优先用清单） -->
  <ItemGroup>
    <AssemblyMetadata Include="StarPiePluginId" Value="com.example.floatingball" />
    <AssemblyMetadata Include="StarPiePluginName" Value="悬浮球" />
    <AssemblyMetadata Include="StarPiePluginCapabilities" Value="Ui;Wheel" />
    <AssemblyMetadata Include="StarPiePluginLicense" Value="MIT" />
    <AssemblyMetadata Include="StarPiePluginHomepage" Value="https://github.com/SoftBlack42/StarPie" />
  </ItemGroup>

  <!-- 清单随产物落地，使「输出目录」本身就是可分发的插件文件夹 -->
  <ItemGroup>
    <None Update="plugin.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>

