<Window x:Class="WinPieGestures.HotkeyBuilderDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="快捷键与组合按键拼装构建器"
        Icon="app_icon.ico"
        Width="500" Height="490"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">
  <Window.Resources>
    <ResourceDictionary>
      <Style x:Key="DlgBtnStyle" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="{DynamicResource ButtonDefaultBgBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ButtonDefaultBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource ArtBorderThickness}" />
        <Setter Property="Foreground" Value="{DynamicResource ButtonDefaultFgBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource ControlCornerRadius}" SnapsToDevicePixels="True">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="bd" Property="Background" Value="{DynamicResource ButtonHoverBgBrush}" />
                  <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                  <Setter TargetName="bd" Property="Background" Value="{DynamicResource ItemHoverBrush}" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="DlgPrimaryBtnStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource DlgBtnStyle}">
        <Setter Property="Background" Value="{DynamicResource AccentPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource ControlCornerRadius}" SnapsToDevicePixels="True">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentHoverBrush}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                  <Setter TargetName="bd" Property="Opacity" Value="0.88" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="QuickChipStyle" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="{DynamicResource SubtleCardBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource ArtBorderThickness}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="Margin" Value="0,0,6,6" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" SnapsToDevicePixels="True">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="bd" Property="Background" Value="{DynamicResource NavTabActiveBgBrush}" />
                  <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style TargetType="{x:Type CheckBox}">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="VerticalAlignment" Value="Center" />
      </Style>
      <Style TargetType="{x:Type ComboBoxItem}">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
        <Setter Property="Padding" Value="8,5" />
        <Setter Property="Cursor" Value="Hand" />
      </Style>
      <Style TargetType="{x:Type TextBox}">
        <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}" />
        <Setter Property="CaretBrush" Value="{DynamicResource TextPrimaryBrush}" />
      </Style>
    </ResourceDictionary>
  </Window.Resources>

  <Grid Margin="18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Header -->
    <StackPanel Grid.Row="0" Margin="0,0,0,12">
      <TextBlock Text="⌨️ 快捷热键与按键组合构建器" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
      <TextBlock Text="自由点选修饰键、主键或常用预设，轻松设置 Alt+Tab、Win+Tab、Shift+Alt 及多位数值。" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,0" TextWrapping="Wrap" />
    </StackPanel>

    <!-- Content Cards -->
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <!-- Quick Presets -->
        <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
          <StackPanel>
            <TextBlock Text="⚡ 常用快捷操作一键预设 (Quick Presets)" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8" />
            <WrapPanel>
              <Button Content="🪟 Ctrl + Alt + Tab (常驻窗口切换器)" Style="{StaticResource QuickChipStyle}" Click="QuickPreset_Click" Tag="Ctrl + Alt + Tab" ToolTip="打开窗口切换列表并常驻在屏幕上，可用鼠标自由点选，无需长按键盘" />
              <Button Content="🪟 Alt + Tab (快速切上一窗口)" Style="{StaticResource QuickChipStyle}" Click="QuickPreset_Click" Tag="Alt + Tab" ToolTip="快速切换回上一个活动窗口" />
              <Button Content="🌟 Win + Tab (任务视图)" Style="{StaticResource QuickChipStyle}" Click="QuickPreset_Click" Tag="Win + Tab" ToolTip="打开 Windows 全局任务视图时间线" />
              <Button Content="⌨️ Shift + Alt (切输入法)" Style="{StaticResource QuickChipStyle}" Click="QuickPreset_Click" Tag="Shift + Alt" />
              <Button Content="⌨️ Ctrl + Shift (切输入法)" Style="{StaticResource QuickChipStyle}" Click="QuickPreset_Click" Tag="Ctrl + Shift" />
              <Button Content="🎨 Alt + Delete (PS填充前景色)" Style="{StaticResource QuickChipStyle}" Click="QuickPreset_Click" Tag="Alt + Delete" />
              <Button Content="🎨 Ctrl + Delete (PS填充背景色)" Style="{StaticResource QuickChipStyle}" Click="QuickPreset_Click" Tag="Ctrl + Delete" />
              <Button Content="🖥️ Win + D (显示桌面)" Style="{StaticResource QuickChipStyle}" Click="QuickPreset_Click" Tag="Win + D" />
              <Button Content="📋 Ctrl + Shift + V (纯文本粘贴)" Style="{StaticResource QuickChipStyle}" Click="QuickPreset_Click" Tag="Ctrl + Shift + V" />
              <Button Content="🔍 Win + S (Windows搜索)" Style="{StaticResource QuickChipStyle}" Click="QuickPreset_Click" Tag="Win + S" />
              <Button Content="🔒 Win + L (快速锁屏)" Style="{StaticResource QuickChipStyle}" Click="QuickPreset_Click" Tag="Win + L" />
            </WrapPanel>
          </StackPanel>
        </Border>

        <!-- Window Switcher Assistant Card -->
        <Border Name="WindowSwitcherTipBorder" Background="{DynamicResource SubtleCardBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10" Visibility="Collapsed">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="💡 窗口切换长按/常驻提示" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentPrimaryBrush}" />
              <TextBlock Text="单次 Alt+Tab 为秒级切换上一个窗口；若希望触发后【保持窗口切换列表常驻在屏幕上】供鼠标点选（无需长按按键），推荐转换为 Ctrl+Alt+Tab 模式。" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" TextWrapping="Wrap" />
            </StackPanel>
            <Button Grid.Column="1" Content="转为常驻模式" Style="{StaticResource DlgPrimaryBtnStyle}" Height="28" Padding="10,0" VerticalAlignment="Center" Margin="10,0,0,0" Click="ConvertToStickyAltTab_Click" />
          </Grid>
        </Border>

        <!-- Modifier Checkboxes Card -->
        <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
          <StackPanel>
            <TextBlock Text="1. 修饰键选择 (Modifiers)" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8" />
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <CheckBox Name="CtrlCheckBox" Content="Ctrl" FontSize="12" FontWeight="Medium" Checked="OnComboChanged" Unchecked="OnComboChanged" />
              <CheckBox Name="ShiftCheckBox" Grid.Column="1" Content="Shift" FontSize="12" FontWeight="Medium" Checked="OnComboChanged" Unchecked="OnComboChanged" />
              <CheckBox Name="AltCheckBox" Grid.Column="2" Content="Alt" FontSize="12" FontWeight="Medium" Checked="OnComboChanged" Unchecked="OnComboChanged" />
              <CheckBox Name="WinCheckBox" Grid.Column="3" Content="Win" FontSize="12" FontWeight="Medium" Checked="OnComboChanged" Unchecked="OnComboChanged" />
            </Grid>
          </StackPanel>
        </Border>

        <!-- Main Key Selector Card -->
        <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
          <StackPanel>
            <Grid Margin="0,0,0,6">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="2. 主按键选择 (Main Key)" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
              <TextBlock Text="💡 可输入关键字快速过滤" Grid.Column="1" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
            </Grid>
            <!-- 检索输入框 -->
            <Grid Margin="0,0,0,6">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBox Name="MainKeySearchBox" Height="28" VerticalContentAlignment="Center" Padding="6,2" FontSize="11.5" Background="{DynamicResource InputBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource InputBorderBrush}" CaretBrush="{DynamicResource TextPrimaryBrush}" TextChanged="MainKeySearchBox_TextChanged" ToolTip="输入按键关键字（如 Pause、F5、Tab、A、Enter 等）即时过滤检索" />
              <TextBlock Name="MainKeySearchPlaceholder" Text="🔍 输入按键名称检索过滤 (如 Pause, Tab, F5, A...)" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="8,0,0,0" IsHitTestVisible="False" />
              <Button Name="MainKeyClearSearchBtn" Grid.Column="1" Content="✕" ToolTip="清空筛选" Width="28" Height="28" Margin="4,0,0,0" Style="{StaticResource DlgBtnStyle}" Padding="0" Click="MainKeyClearSearchBtn_Click" Visibility="Collapsed" />
            </Grid>
            <ComboBox Name="MainKeyComboBox" Style="{DynamicResource FlatComboBoxStyle}" Height="30" SelectionChanged="OnComboChanged">
              <ComboBoxItem Content="(无主键 / 仅修饰键组合，如 Shift+Alt)" Tag="" />
              <ComboBoxItem Content="Tab (切换焦点/窗口)" Tag="Tab" />
              <ComboBoxItem Content="Delete (删除)" Tag="Delete" />
              <ComboBoxItem Content="Backspace (退格)" Tag="Backspace" />
              <ComboBoxItem Content="Enter / Return (回车)" Tag="Enter" />
              <ComboBoxItem Content="Esc (退出/取消)" Tag="Esc" />
              <ComboBoxItem Content="Space (空格)" Tag="Space" />
              <ComboBoxItem Content="Insert (插入)" Tag="Insert" />
              <ComboBoxItem Content="Home" Tag="Home" />
              <ComboBoxItem Content="End" Tag="End" />
              <ComboBoxItem Content="PageUp" Tag="PageUp" />
              <ComboBoxItem Content="PageDown" Tag="PageDown" />
              <ComboBoxItem Content="↑ 方向键上 (Up)" Tag="Up" />
              <ComboBoxItem Content="↓ 方向键下 (Down)" Tag="Down" />
              <ComboBoxItem Content="← 方向键左 (Left)" Tag="Left" />
              <ComboBoxItem Content="→ 方向键右 (Right)" Tag="Right" />
              <ComboBoxItem Content="F1" Tag="F1" />
              <ComboBoxItem Content="F2" Tag="F2" />
              <ComboBoxItem Content="F3" Tag="F3" />
              <ComboBoxItem Content="F4" Tag="F4" />
              <ComboBoxItem Content="F5" Tag="F5" />
              <ComboBoxItem Content="F6" Tag="F6" />
              <ComboBoxItem Content="F7" Tag="F7" />
              <ComboBoxItem Content="F8" Tag="F8" />
              <ComboBoxItem Content="F9" Tag="F9" />
              <ComboBoxItem Content="F10" Tag="F10" />
              <ComboBoxItem Content="F11" Tag="F11" />
              <ComboBoxItem Content="F12" Tag="F12" />
              <ComboBoxItem Content="A" Tag="A" />
              <ComboBoxItem Content="B" Tag="B" />
              <ComboBoxItem Content="C" Tag="C" />
              <ComboBoxItem Content="D" Tag="D" />
              <ComboBoxItem Content="E" Tag="E" />
              <ComboBoxItem Content="F" Tag="F" />
              <ComboBoxItem Content="G" Tag="G" />
              <ComboBoxItem Content="H" Tag="H" />
              <ComboBoxItem Content="I" Tag="I" />
              <ComboBoxItem Content="J" Tag="J" />
              <ComboBoxItem Content="K" Tag="K" />
              <ComboBoxItem Content="L" Tag="L" />
              <ComboBoxItem Content="M" Tag="M" />
              <ComboBoxItem Content="N" Tag="N" />
              <ComboBoxItem Content="O" Tag="O" />
              <ComboBoxItem Content="P" Tag="P" />
              <ComboBoxItem Content="Q" Tag="Q" />
              <ComboBoxItem Content="R" Tag="R" />
              <ComboBoxItem Content="S" Tag="S" />
              <ComboBoxItem Content="T" Tag="T" />
              <ComboBoxItem Content="U" Tag="U" />
              <ComboBoxItem Content="V" Tag="V" />
              <ComboBoxItem Content="W" Tag="W" />
              <ComboBoxItem Content="X" Tag="X" />
              <ComboBoxItem Content="Y" Tag="Y" />
              <ComboBoxItem Content="Z" Tag="Z" />
              <ComboBoxItem Content="0" Tag="0" />
              <ComboBoxItem Content="1" Tag="1" />
              <ComboBoxItem Content="2" Tag="2" />
              <ComboBoxItem Content="3" Tag="3" />
              <ComboBoxItem Content="4" Tag="4" />
              <ComboBoxItem Content="5" Tag="5" />
              <ComboBoxItem Content="6" Tag="6" />
              <ComboBoxItem Content="7" Tag="7" />
              <ComboBoxItem Content="8" Tag="8" />
              <ComboBoxItem Content="9" Tag="9" />
              <ComboBoxItem Content="PrintScreen (截屏)" Tag="PrintScreen" />
              <ComboBoxItem Content="Pause / Break (暂停)" Tag="Pause" />
              <ComboBoxItem Content="CapsLock (大小写)" Tag="CapsLock" />
              <ComboBoxItem Content="Num0" Tag="Num0" />
              <ComboBoxItem Content="Num1" Tag="Num1" />
              <ComboBoxItem Content="Num2" Tag="Num2" />
              <ComboBoxItem Content="Num3" Tag="Num3" />
              <ComboBoxItem Content="Num4" Tag="Num4" />
              <ComboBoxItem Content="Num5" Tag="Num5" />
              <ComboBoxItem Content="Num6" Tag="Num6" />
              <ComboBoxItem Content="Num7" Tag="Num7" />
              <ComboBoxItem Content="Num8" Tag="Num8" />
              <ComboBoxItem Content="Num9" Tag="Num9" />
              <ComboBoxItem Content="NumAdd (+)" Tag="NumAdd" />
              <ComboBoxItem Content="NumSubtract (-)" Tag="NumSubtract" />
              <ComboBoxItem Content="NumMultiply (*)" Tag="NumMultiply" />
              <ComboBoxItem Content="NumDivide (/)" Tag="NumDivide" />
              <ComboBoxItem Content="NumDecimal (.)" Tag="NumDecimal" />
            </ComboBox>
          </StackPanel>
        </Border>

        <!-- Direct Text / Number Input Card -->
        <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="直接编辑 / 连续数值: " FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBox Name="CustomInputTextBox" Grid.Column="1" Height="30" VerticalContentAlignment="Center" Padding="6,2" TextChanged="CustomInputTextBox_TextChanged" Background="{DynamicResource InputBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource InputBorderBrush}" />
          </Grid>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <!-- Bottom Action Bar -->
    <Grid Grid.Row="2" Margin="0,14,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <TextBlock Text="当前组合预览: " FontSize="12" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
        <Border Background="{DynamicResource ItemHoverBrush}" CornerRadius="{DynamicResource ControlCornerRadius}" Padding="8,3" Margin="6,0,0,0">
          <TextBlock Name="PreviewResultText" Text="(空)" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}" VerticalAlignment="Center" />
        </Border>
      </StackPanel>

      <Button Name="CancelButton" Grid.Column="1" Content="取消" Width="80" Height="32" Margin="0,0,10,0" Click="CancelButton_Click" Style="{StaticResource DlgBtnStyle}" IsCancel="True" />
      <Button Name="OkButton" Grid.Column="2" Content="确定应用" Width="90" Height="32" Click="OkButton_Click" Style="{StaticResource DlgPrimaryBtnStyle}" IsDefault="True" />
    </Grid>
  </Grid>
</Window>