<Window x:Class="WinPieGestures.CustomSoundEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="StarPie - 自定义交互音效调音台 (Custom Sound Studio Demo)"
        Icon="app_icon.ico"
        Width="920" Height="720" MinWidth="850" MinHeight="600"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="Segoe UI, Microsoft YaHei UI, Arial">
  <Window.Resources>
    <ResourceDictionary>
      <BooleanToVisibilityConverter x:Key="BoolToVis" />

      <!-- 通用按钮样式 -->
      <Style x:Key="DlgBtnStyle" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="{DynamicResource ButtonDefaultBgBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ButtonDefaultBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource ArtBorderThickness}" />
        <Setter Property="Foreground" Value="{DynamicResource ButtonDefaultFgBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource ControlCornerRadius}" SnapsToDevicePixels="True">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="bd" Property="Background" Value="{DynamicResource ButtonHoverBgBrush}" />
                  <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                  <Setter TargetName="bd" Property="Background" Value="{DynamicResource ItemHoverBrush}" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <Style x:Key="DlgPrimaryBtnStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource DlgBtnStyle}">
        <Setter Property="Background" Value="{DynamicResource AccentPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource ControlCornerRadius}" SnapsToDevicePixels="True">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentHoverBrush}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                  <Setter TargetName="bd" Property="Opacity" Value="0.88" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <Style x:Key="AuditionBtnStyle" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="{DynamicResource AccentPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="5" SnapsToDevicePixels="True">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentHoverBrush}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                  <Setter TargetName="bd" Property="Opacity" Value="0.8" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <Style TargetType="{x:Type TextBox}">
        <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}" />
        <Setter Property="CaretBrush" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="Padding" Value="6,4" />
        <Setter Property="FontSize" Value="12" />
      </Style>

      <Style TargetType="{x:Type ComboBoxItem}">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
        <Setter Property="Padding" Value="8,5" />
        <Setter Property="Cursor" Value="Hand" />
      </Style>
    </ResourceDictionary>
  </Window.Resources>

  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- 顶部标题栏与方案切换工具栏 -->
    <StackPanel Grid.Row="0" Margin="0,0,0,16">
      <Grid Margin="0,0,0,10">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="🎛️ 自定义交互音效调音台" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
            <Border Background="#10B981" CornerRadius="4" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
              <TextBlock Text="UI Demo 体验版" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF" />
            </Border>
          </StackPanel>
          <TextBlock Text="基于原生 Win32 零延迟音频引擎，为 5 个核心交互手势事件定制程序化极微波形、本地音频采样与音高音量。" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <!-- 方案快捷操作 -->
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Content="➕ 新建方案" Style="{StaticResource DlgBtnStyle}" Margin="0,0,6,0" Click="NewProfile_Click" ToolTip="创建全新的自定义音效方案" />
          <Button Name="DeleteProfileButton" Content="🗑️ 删除方案" Style="{StaticResource DlgBtnStyle}" Margin="0,0,6,0" Click="DeleteProfile_Click" ToolTip="删除当前自定义音效方案" />
          <Button Content="📂 导入方案" Style="{StaticResource DlgBtnStyle}" Margin="0,0,6,0" Click="ImportProfile_Click" ToolTip="从 JSON 或音频包导入音效方案" />
          <Button Content="💾 导出方案" Style="{StaticResource DlgBtnStyle}" Margin="0,0,6,0" Click="ExportProfile_Click" ToolTip="导出当前调配好的音效方案为文件" />
          <Button Content="🔄 恢复默认" Style="{StaticResource DlgBtnStyle}" Click="ResetProfile_Click" ToolTip="重置当前方案为内置初始值" />
        </StackPanel>
      </Grid>

      <!-- 方案选择卡片 -->
      <Border Background="{DynamicResource SubtleCardBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,10">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="当前配置方案:" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
          <ComboBox Name="ProfileSelectorComboBox" Grid.Column="1" Height="32" VerticalAlignment="Center" Style="{StaticResource FlatComboBoxStyle}" SelectionChanged="ProfileSelectorComboBox_SelectionChanged" />
          <TextBlock Name="ProfileDescriptionLabel" Grid.Column="2" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="14,0,0,0" TextTrimming="CharacterEllipsis" />
        </Grid>
      </Border>
    </StackPanel>

    <!-- 中间 5 大手势交互事件调音矩阵 -->
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,-6,0" Padding="0,0,6,0">
      <StackPanel Name="EventsContainerStackPanel">
        <!-- 5 个事件卡片将由代码后台动态生成或静态组织 -->
      </StackPanel>
    </ScrollViewer>

    <!-- 底部状态指示与操作栏 -->
    <Border Grid.Row="2" Margin="0,14,0,0" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,1,0,0" Padding="0,14,0,0">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- 连续试听与状态展示 -->
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Button Name="PlaySequenceButton" Content="🔊 连续模拟完整手势交互体验" Style="{StaticResource DlgPrimaryBtnStyle}" Height="34" Padding="16,0" Click="PlaySequenceButton_Click" ToolTip="依次回放：轮盘唤出 ➔ 划过扇区 ➔ 二级展开 ➔ 动作执行 ➔ 顺势脱离" />
          <TextBlock Name="SequenceStatusLabel" Text="准备就绪" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="14,0,0,0" />
        </StackPanel>

        <!-- 保存与关闭 -->
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Content="💾 保存方案" Style="{StaticResource DlgPrimaryBtnStyle}" Height="34" Padding="20,0" Margin="0,0,8,0" Click="SaveButton_Click" />
          <Button Content="✕ 关闭" Style="{StaticResource DlgBtnStyle}" Height="34" Padding="16,0" Click="CloseButton_Click" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
