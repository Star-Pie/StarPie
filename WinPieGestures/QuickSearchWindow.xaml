<Window x:Class="WinPieGestures.QuickSearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="全盘文件与程序秒搜 (Quick Finder) - StarPie"
        Width="740" Height="530"
        MinWidth="560" MinHeight="380"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        FontFamily="Segoe UI, Microsoft YaHei UI, Arial"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        Deactivated="Window_Deactivated"
        KeyDown="Window_KeyDown"
        Loaded="Window_Loaded">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <!-- 强调色默认回退画刷 -->
      <SolidColorBrush x:Key="AccentPrimaryBrush" Color="#2563EB" />
      <SolidColorBrush x:Key="AccentHoverBrush" Color="#1D4ED8" />
      <SolidColorBrush x:Key="AccentTextBrush" Color="#FFFFFF" />

      <!-- 通用按钮样式 -->
      <Style x:Key="ModernBtn" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="{DynamicResource ButtonDefaultBgBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ButtonDefaultBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource ArtBorderThickness}" />
        <Setter Property="Foreground" Value="{DynamicResource ButtonDefaultFgBrush}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource ControlCornerRadius}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter Value="{DynamicResource ButtonHoverBgBrush}" Property="Background" />
                  <Setter Value="{DynamicResource AccentPrimaryBrush}" Property="BorderBrush" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- 现代强调高亮按钮样式 (用于搜索触发等主要操作) -->
      <Style x:Key="ModernAccentBtn" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="{DynamicResource AccentPrimaryBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource ArtBorderThickness}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource ControlCornerRadius}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter Value="{DynamicResource AccentHoverBrush}" Property="Background" />
                  <Setter Value="{DynamicResource AccentHoverBrush}" Property="BorderBrush" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                  <Setter Value="{DynamicResource AccentHoverBrush}" Property="Background" />
                  <Setter Property="Opacity" Value="0.88" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- 现代右键菜单样式 -->
      <Style x:Key="ModernContextMenu" TargetType="{x:Type ContextMenu}">
        <Setter Property="Background" Value="{DynamicResource WindowBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource ArtBorderThickness}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="Padding" Value="4,4" />
        <Setter Property="HasDropShadow" Value="True" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type ContextMenu}">
              <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                <Border.Effect>
                  <DropShadowEffect BlurRadius="16" ShadowDepth="2" Color="#000000" Opacity="0.25" />
                </Border.Effect>
                <ItemsPresenter />
              </Border>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <Style x:Key="ModernMenuItem" TargetType="{x:Type MenuItem}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type MenuItem}">
              <Border Name="MenuBorder" Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}" Margin="2,1">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="22" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <ContentPresenter Grid.Column="0" ContentSource="Icon" VerticalAlignment="Center" HorizontalAlignment="Left" />
                  <ContentPresenter Grid.Column="1" ContentSource="Header" VerticalAlignment="Center" Margin="4,0,12,0" />
                  <TextBlock Grid.Column="2" Text="{TemplateBinding InputGestureText}" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" VerticalAlignment="Center" />
                </Grid>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                  <Setter TargetName="MenuBorder" Property="Background" Value="{DynamicResource ItemHoverBrush}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- 搜索结果列表项样式 -->
      <Style x:Key="SearchResultItemStyle" TargetType="{x:Type ListBoxItem}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="Margin" Value="0,0,0,2" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type ListBoxItem}">
              <Border Name="ItemBorder" Background="{TemplateBinding Background}" BorderThickness="1" BorderBrush="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}">
                <ContentPresenter />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource ItemHoverBrush}" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                  <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource SubtleCardBrush}" />
                  <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>

  <!-- 外层发光圆角卡片 -->
  <Border Margin="14" CornerRadius="16" Background="{DynamicResource WindowBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1.2" MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <Border.Effect>
      <DropShadowEffect BlurRadius="28" ShadowDepth="3" Color="#000000" Opacity="0.32" />
    </Border.Effect>

    <Grid>
      <Grid.RowDefinitions>
        <!-- 行 0: 顶部搜索栏 -->
        <RowDefinition Height="64" />
        <!-- 行 1: 分类过滤药丸栏 -->
        <RowDefinition Height="40" />
        <!-- 行 2: 结果列表区 -->
        <RowDefinition Height="*" />
        <!-- 行 3: 操作执行反馈横幅 (按需弹出) -->
        <RowDefinition Height="Auto" />
        <!-- 行 4: 底部操作快捷键说明栏 -->
        <RowDefinition Height="38" />
      </Grid.RowDefinitions>

      <!-- 顶部搜索输入卡片 (支持鼠标按住自由拖拽移动) -->
      <Border Grid.Row="0" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,0,1" Padding="16,10" MouseLeftButtonDown="Window_MouseLeftButtonDown" Background="Transparent">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <!-- 搜索输入框与占位符 -->
          <Grid Grid.Column="0" VerticalAlignment="Center" Margin="2,0,8,0">
            <TextBox Name="SearchInputBox" Background="Transparent" Foreground="{DynamicResource TextPrimaryBrush}" BorderThickness="0" FontSize="16" FontWeight="Normal" VerticalAlignment="Center" TextChanged="SearchInputBox_TextChanged" KeyDown="SearchInputBox_KeyDown" />
            <TextBlock Name="PlaceholderText" Text="输入关键词秒搜文件、应用或CAD工程... (按 ↑↓ 选择, Enter 打开)" FontSize="14.5" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" IsHitTestVisible="False" Margin="2,0,0,0" />
          </Grid>

          <!-- 清空输入按钮 -->
          <Button Name="ClearInputBtn" Grid.Column="1" Content="✕" Width="26" Height="26" FontSize="11" Margin="0,0,6,0" Style="{StaticResource ModernBtn}" Visibility="Collapsed" Click="ClearInputBtn_Click" ToolTip="清空输入内容" />

          <!-- 正在搜索状态提示 (动态显隐) -->
          <Border Name="SearchingIndicator" Grid.Column="2" Visibility="Collapsed" Background="#143B82F6" BorderBrush="#303B82F6" BorderThickness="{DynamicResource ArtBorderThickness}" CornerRadius="{DynamicResource ControlCornerRadius}" Padding="8,4" Margin="0,0,8,0" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock Text="⏳" FontSize="11" Margin="0,0,4,0" VerticalAlignment="Center" />
              <TextBlock Text="正在搜索..." FontSize="11.5" Foreground="{DynamicResource AccentPrimaryBrush}" FontWeight="Medium" VerticalAlignment="Center" />
            </StackPanel>
          </Border>

          <!-- 搜索执行按钮 (位于右侧，点击立即触发全盘检索) -->
          <Button Name="SearchBtn" Grid.Column="3" Width="36" Height="30" Style="{StaticResource ModernAccentBtn}" Margin="0,0,8,0" Click="SearchBtn_Click" ToolTip="开始搜索 (Enter)">
            <Path HorizontalAlignment="Center" VerticalAlignment="Center" Width="14" Height="14" Stretch="Uniform" Fill="{DynamicResource AccentTextBrush}"
                  Data="M9.5,3A6.5,6.5 0 0,1 16,9.5C16,11.11 15.41,12.59 14.44,13.73L14.71,14H15.5L20.5,19L19,20.5L14,15.5V14.71L13.73,14.44C12.59,15.41 11.11,16 9.5,16A6.5,6.5 0 0,1 3,9.5A6.5,6.5 0 0,1 9.5,3M9.5,5C7,5 5,7 5,9.5C5,12 7,14 9.5,14C12,14 14,12 14,9.5C14,7 12,5 9.5,5Z" />
          </Button>

          <!-- 窗口置顶图钉按钮 -->
          <Button Name="PinBtn" Grid.Column="4" Width="28" Height="28" Content="📌" FontSize="12" Style="{StaticResource ModernBtn}" Margin="0,0,6,0" Click="PinBtn_Click" ToolTip="窗口置顶 (点击固定在最前端，失焦不隐藏)" />

          <!-- 关闭按钮 -->
          <Button Grid.Column="5" Width="28" Height="28" Content="✕" FontSize="12" Style="{StaticResource ModernBtn}" Click="CloseButton_Click" ToolTip="关闭 (Esc)" />
        </Grid>
      </Border>

      <!-- 分类过滤栏 (Category Chips) -->
      <Border Grid.Row="1" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,0,1" Padding="14,4">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="分类过滤:" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
          <Button Name="FilterAllBtn" Content="全部" Style="{StaticResource ModernBtn}" Height="26" Padding="8,0" Margin="0,0,6,0" FontSize="10.5" Click="FilterChip_Click" Tag="All" />
          <Button Name="FilterAppsBtn" Content="💻 应用程序" Style="{StaticResource ModernBtn}" Height="26" Padding="8,0" Margin="0,0,6,0" FontSize="10.5" Click="FilterChip_Click" Tag="App" />
          <Button Name="FilterCadBtn" Content="📐 机械/CAD" Style="{StaticResource ModernBtn}" Height="26" Padding="8,0" Margin="0,0,6,0" FontSize="10.5" Click="FilterChip_Click" Tag="CAD" />
          <Button Name="FilterDocsBtn" Content="📄 文档/代码" Style="{StaticResource ModernBtn}" Height="26" Padding="8,0" Margin="0,0,6,0" FontSize="10.5" Click="FilterChip_Click" Tag="Doc" />
          <Button Name="FilterVideoBtn" Content="🎬 视频" Style="{StaticResource ModernBtn}" Height="26" Padding="8,0" Margin="0,0,6,0" FontSize="10.5" Click="FilterChip_Click" Tag="Video" />
          <Button Name="FilterFoldersBtn" Content="📁 常用目录" Style="{StaticResource ModernBtn}" Height="26" Padding="8,0" Margin="0,0,6,0" FontSize="10.5" Click="FilterChip_Click" Tag="Folder" />
          <Button Name="FilterSystemBtn" Content="⚙️ 系统管理" Style="{StaticResource ModernBtn}" Height="26" Padding="8,0" FontSize="10.5" Click="FilterChip_Click" Tag="System" />
        </StackPanel>
      </Border>

      <!-- 搜索结果列表 -->
      <Grid Grid.Row="2">
        <ListBox Name="ResultsListBox" Background="Transparent" BorderThickness="0" Padding="8" ItemContainerStyle="{StaticResource SearchResultItemStyle}" SelectionMode="Single" MouseDoubleClick="ResultsListBox_MouseDoubleClick">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid Margin="2,0">
                <Grid.ContextMenu>
                  <ContextMenu Style="{StaticResource ModernContextMenu}" Opened="ContextMenu_Opened" Closed="ContextMenu_Closed">
                    <MenuItem Header="打开" Click="ContextOpen_Click" Style="{StaticResource ModernMenuItem}" InputGestureText="Enter">
                      <MenuItem.Icon>
                        <TextBlock Text="↵" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}" />
                      </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="在资源管理器中定位" Click="ContextReveal_Click" Style="{StaticResource ModernMenuItem}" InputGestureText="Shift+Enter">
                      <MenuItem.Icon>
                        <TextBlock Text="📂" FontSize="12" />
                      </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="以管理员身份运行" Click="ContextRunAsAdmin_Click" Style="{StaticResource ModernMenuItem}">
                      <MenuItem.Icon>
                        <TextBlock Text="🛡️" FontSize="12" />
                      </MenuItem.Icon>
                    </MenuItem>
                    <Separator Background="{DynamicResource CardBorderBrush}" Margin="2,3" />
                    <MenuItem Header="复制完整路径" Click="ContextCopyPath_Click" Style="{StaticResource ModernMenuItem}">
                      <MenuItem.Icon>
                        <TextBlock Text="📋" FontSize="12" />
                      </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="复制文件名" Click="ContextCopyFileName_Click" Style="{StaticResource ModernMenuItem}">
                      <MenuItem.Icon>
                        <TextBlock Text="📝" FontSize="12" />
                      </MenuItem.Icon>
                    </MenuItem>
                  </ContextMenu>
                </Grid.ContextMenu>

                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 图标徽章 -->
                <Border Grid.Column="0" Width="36" Height="36" CornerRadius="8" Background="{Binding BadgeBg}" Margin="0,0,12,0" VerticalAlignment="Center">
                  <TextBlock Text="{Binding IconEmoji}" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <!-- 标题与完整路径 -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                  <TextBlock Text="{Binding FileName}" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding FullPath}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <!-- 右侧信息与操作按钮 -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                  <Border CornerRadius="4" Background="{DynamicResource SubtleCardBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Padding="6,2" Margin="0,0,8,0">
                    <TextBlock Text="{Binding CategoryDisplay}" FontSize="10" Foreground="{Binding BadgeFg}" FontWeight="Medium" />
                  </Border>
                  <TextBlock Text="{Binding Details}" FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                  <Button Content="↵ 打开" Style="{StaticResource ModernBtn}" Height="24" Padding="6,0" FontSize="10" Click="ItemOpen_Click" Tag="{Binding}" />
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

          <!-- 无匹配结果空状态提示 -->
          <StackPanel Name="EmptyResultsNotice" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Name="EmptyNoticeEmoji" Text="🔍" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,8" />
            <TextBlock Name="EmptyNoticeTitle" Text="未找到匹配的文件或程序" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" />
            <TextBlock Name="EmptyNoticeSub" Text="尝试换个关键词，或切换上方「全部」分类" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,4,0,0" />
          </StackPanel>
        </Grid>

        <!-- 操作执行反馈横幅 (当用户复制路径、启动失败或提示时展开) -->
        <Border Name="ActionFeedbackBanner" Grid.Row="3" Background="#1810B981" BorderBrush="#6010B981" BorderThickness="0,1,0,0" Padding="14,8" Visibility="Collapsed">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock Name="ActionFeedbackIcon" Text="✨" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center" />
              <TextBlock Name="ActionFeedbackText" Text="已执行操作" FontSize="11.5" FontWeight="SemiBold" Foreground="#10B981" VerticalAlignment="Center" />
            </StackPanel>
            <Button Grid.Column="1" Content="✕" Width="20" Height="20" FontSize="10" Style="{StaticResource ModernBtn}" Click="CloseFeedbackBtn_Click" ToolTip="关闭提示" />
          </Grid>
        </Border>

        <!-- 底部快捷键说明与统计栏 -->
        <Border Grid.Row="4" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,1,0,0" Padding="16,0" MouseLeftButtonDown="Window_MouseLeftButtonDown">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- 快捷操作提示 -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock Text="操作指引:" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
              <Border Background="{DynamicResource SubtleCardBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="5,1" Margin="0,0,4,0">
                <TextBlock Text="↑ / ↓ 移动" FontSize="10" Foreground="{DynamicResource TextPrimaryBrush}" />
              </Border>
              <Border Background="{DynamicResource SubtleCardBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="5,1" Margin="0,0,4,0">
                <TextBlock Text="↵ 打开" FontSize="10" Foreground="{DynamicResource TextPrimaryBrush}" />
              </Border>
              <Border Background="{DynamicResource SubtleCardBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="5,1" Margin="0,0,4,0">
                <TextBlock Text="Shift+↵ 定位" FontSize="10" Foreground="{DynamicResource TextPrimaryBrush}" />
              </Border>
              <Border Background="{DynamicResource SubtleCardBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="5,1" Margin="0,0,4,0">
                <TextBlock Text="右键 更多" FontSize="10" Foreground="{DynamicResource TextPrimaryBrush}" />
              </Border>
              <Border Background="{DynamicResource SubtleCardBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="5,1" Margin="0,0,4,0">
                <TextBlock Text="Esc 退出" FontSize="10" Foreground="{DynamicResource TextPrimaryBrush}" />
              </Border>
            </StackPanel>

            <!-- 响应时间与结果统计及右下角拉伸把手 -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock Name="StatusCountText" Text="就绪" FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
            <Thumb Name="WindowResizeGrip" Width="14" Height="14" Cursor="SizeNWSE" VerticalAlignment="Center" DragDelta="WindowResizeGrip_DragDelta" ToolTip="按住拖拽自由拉伸窗口大小">
              <Thumb.Template>
                <ControlTemplate TargetType="{x:Type Thumb}">
                  <Grid Background="Transparent">
                    <Path HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,1,1" Width="8" Height="8" Stretch="Uniform" Fill="{DynamicResource TextMutedBrush}"
                          Data="M6,0 L8,0 L8,2 L6,2 Z M3,3 L5,3 L5,5 L3,5 Z M6,3 L8,3 L8,5 L6,5 Z M0,6 L2,6 L2,8 L0,8 Z M3,6 L5,6 L5,8 L3,8 Z M6,6 L8,6 L8,8 L6,8 Z" />
                  </Grid>
                </ControlTemplate>
              </Thumb.Template>
            </Thumb>
          </StackPanel>
        </Grid>
      </Border>

      <!-- 右侧边缘自由拖拽调整宽度 -->
      <Thumb Grid.RowSpan="5" HorizontalAlignment="Right" Width="6" Cursor="SizeWE" DragDelta="RightEdge_DragDelta">
        <Thumb.Template>
          <ControlTemplate TargetType="{x:Type Thumb}">
            <Border Background="Transparent" />
          </ControlTemplate>
        </Thumb.Template>
      </Thumb>

      <!-- 底侧边缘自由拖拽调整高度 -->
      <Thumb Grid.Row="4" VerticalAlignment="Bottom" Height="6" Cursor="SizeNS" DragDelta="BottomEdge_DragDelta">
        <Thumb.Template>
          <ControlTemplate TargetType="{x:Type Thumb}">
            <Border Background="Transparent" />
          </ControlTemplate>
        </Thumb.Template>
      </Thumb>
    </Grid>
  </Border>
</Window>
