<UserControl x:Class="WinPieGestures.MappingsProfileRail"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <UserControl.Resources>
  <BooleanToVisibilityConverter x:Key="FlagVisibility"/>
  <Style x:Key="RailButton" TargetType="Button">
   <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
   <Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="4"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="Hit" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/></Border>
    <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Hit" Property="Background" Value="{DynamicResource SubtleCardBrush}"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".4"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
 </UserControl.Resources>
 <Border Padding="8" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8">
  <Grid>
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <TextBlock x:Name="Title" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="2,1,0,8"/>
   <Grid Grid.Row="1" Margin="0,0,0,7"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <TextBox x:Name="Search" Padding="5,3" VerticalContentAlignment="Center" TextChanged="SearchChanged"/>
    <TextBlock x:Name="Hint" Margin="7,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
    <Button x:Name="Filter" Grid.Column="1" Content="#" MinWidth="24" Margin="2,0,0,0" Style="{StaticResource RailButton}" Click="FilterClick"/>
   </Grid>
   <Grid Grid.Row="2">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False">
     <ItemsControl x:Name="Cards" HorizontalContentAlignment="Stretch">
      <ItemsControl.ItemTemplate><DataTemplate>
       <Border x:Name="Card" Background="Transparent" Margin="0,2" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="4">
        <StackPanel>
         <Grid>
          <Button Style="{StaticResource RailButton}" Tag="{Binding Profile}" Click="SelectClick" ToolTip="{Binding Profile.DisplayTitle}">
           <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <Grid Width="24" Height="24" VerticalAlignment="Top"><TextBlock Text="{Binding Glyph}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="18" Foreground="{DynamicResource TextPrimaryBrush}"/>
             <Image Tag="{Binding Profile}" Loaded="ImageLoaded" Stretch="Uniform"/></Grid>
            <StackPanel Grid.Column="1">
             <TextBlock Text="{Binding Profile.FriendlyName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextPrimaryBrush}"/>
             <TextBlock Text="{Binding Summary}" ToolTip="{Binding Summary}" FontSize="10" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextSecondaryBrush}"/>
             <TextBlock Text="{Binding TagCaption}" TextTrimming="CharacterEllipsis" Visibility="{Binding HasTags,Converter={StaticResource FlagVisibility}}" FontSize="10" Foreground="{DynamicResource AccentPrimaryBrush}"/>
            </StackPanel>
           </Grid>
          </Button>
          <Border x:Name="CardActions" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,2,0" Padding="2,1"
                  CornerRadius="4" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                  Opacity="0" IsHitTestVisible="False">
           <StackPanel Orientation="Horizontal">
            <Button Style="{StaticResource RailButton}" Content="↗" Tag="{Binding Profile}" ToolTip="{Binding Export}" AutomationProperties.Name="{Binding Export}" Click="ExportClick"/>
            <Button Style="{StaticResource RailButton}" Content="⧉" Tag="{Binding Profile}" ToolTip="{Binding Copy}" AutomationProperties.Name="{Binding Copy}" Click="CopyClick"/>
            <Button Style="{StaticResource RailButton}" Content="×" Tag="{Binding Profile}" ToolTip="{Binding Delete}" AutomationProperties.Name="{Binding Delete}" Click="DeleteClick" IsEnabled="{Binding CanDelete}"/>
           </StackPanel>
          </Border>
         </Grid>
         <StackPanel Visibility="{Binding ShowLayers,Converter={StaticResource FlagVisibility}}" Margin="8,2,0,0">
          <ItemsControl ItemsSource="{Binding Layers}"><ItemsControl.ItemTemplate><DataTemplate>
           <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Button Style="{StaticResource RailButton}" Click="LayerClick" PreviewMouseRightButtonUp="LayerRightClick" ToolTip="{Binding Tooltip}"><StackPanel Orientation="Vertical">
             <TextBlock x:Name="LayerTitle" Text="{Binding Layer.DisplayName}" TextTrimming="CharacterEllipsis"/>
             <TextBlock Text="{Binding Caption}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
            </StackPanel></Button>
            <Button Grid.Column="1" Style="{StaticResource RailButton}" Content="⋯" Click="LayerMenuClick" VerticalAlignment="Center" ToolTip="{Binding Actions}" AutomationProperties.Name="{Binding Actions}"/>
           </Grid><DataTemplate.Triggers><DataTrigger Binding="{Binding Selected}" Value="True"><Setter TargetName="LayerTitle" Property="Foreground" Value="{DynamicResource AccentPrimaryBrush}"/><Setter TargetName="LayerTitle" Property="FontWeight" Value="SemiBold"/></DataTrigger></DataTemplate.Triggers>
          </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
          <Button Style="{StaticResource RailButton}" Content="{Binding AddLayer}" Tag="{Binding Profile}" Click="AddLayerClick" FontSize="11"/>
         </StackPanel>
        </StackPanel>
       </Border>
       <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding Selected}" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}"/></DataTrigger>
        <Trigger SourceName="Card" Property="IsMouseOver" Value="True"><Setter TargetName="CardActions" Property="Opacity" Value="1"/><Setter TargetName="CardActions" Property="IsHitTestVisible" Value="True"/></Trigger>
        <Trigger SourceName="Card" Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="CardActions" Property="Opacity" Value="1"/><Setter TargetName="CardActions" Property="IsHitTestVisible" Value="True"/></Trigger>
       </DataTemplate.Triggers>
      </DataTemplate></ItemsControl.ItemTemplate>
     </ItemsControl>
    </ScrollViewer>
    <TextBlock x:Name="NoMatch" TextWrapping="Wrap" Margin="3,10" VerticalAlignment="Top" Foreground="{DynamicResource TextSecondaryBrush}" Visibility="Collapsed"/>
   </Grid>
   <UniformGrid Grid.Row="3" Rows="1" Columns="2" Margin="0,6,0,0">
    <Button x:Name="Add" Style="{DynamicResource ModernButtonStyle}" Padding="4" Margin="0,0,2,0" Click="AddClick"/>
    <Button x:Name="Import" Style="{DynamicResource ModernButtonStyle}" Padding="4" Margin="2,0,0,0" Click="ImportClick"/>
   </UniformGrid>
  </Grid>
 </Border>
</UserControl>
