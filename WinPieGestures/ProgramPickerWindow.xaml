<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="WinPieGestures.ProgramPickerWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="选择程序 - StarPie" Icon="app_icon.ico" Height="540" Width="490" Background="{DynamicResource WindowBackgroundBrush}" FontFamily="Segoe UI, Microsoft YaHei" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" xmlns:winpiegestures="clr-namespace:WinPieGestures;assembly=StarPie" Loaded="Window_Loaded">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <Style x:Key="PickerBtn" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="{DynamicResource ButtonDefaultBgBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ButtonDefaultBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource ArtBorderThickness}" />
        <Setter Property="Foreground" Value="{DynamicResource ButtonDefaultFgBrush}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="FrameworkElement.Cursor" Value="Hand" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Background="{TemplateBinding Control.Background}" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}" CornerRadius="{DynamicResource ControlCornerRadius}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Control.Padding}" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter Value="{DynamicResource ButtonHoverBgBrush}" Property="Background" />
                  <Setter Value="{DynamicResource AccentPrimaryBrush}" Property="BorderBrush" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="PrimaryPickerBtn" TargetType="{x:Type Button}" BasedOn="{StaticResource PickerBtn}">
        <Setter Property="Background" Value="{DynamicResource AccentPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Background="{TemplateBinding Control.Background}" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}" CornerRadius="{DynamicResource ControlCornerRadius}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Control.Padding}" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter Value="{DynamicResource AccentHoverBrush}" Property="Background" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid Margin="18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <TextBlock Name="HeaderTitleText" Grid.Row="0" Text="从已安装的软件、微软商店与开始菜单中选择" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12" />
    <Grid Row="1" Margin="0,0,0,10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Grid Column="0" Margin="0,0,8,0">
        <TextBox Name="SearchTextBox" Height="34" VerticalContentAlignment="Center" Padding="30,0,10,0" Background="{DynamicResource InputBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1" FontSize="12" TextChanged="SearchTextBox_TextChanged" />
        <TextBlock Text="🔍" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="10,0,0,0" IsHitTestVisible="False" />
        <TextBlock Name="SearchPlaceholderText" Text="搜索软件名称、微软商店应用、拼音首字母(如jsb/jsq)..." FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Opacity="0.6" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="30,0,0,0" IsHitTestVisible="False" />
      </Grid>
      <Button Name="RefreshButton" Grid.Column="1" Content="🔄 刷新" Style="{StaticResource PickerBtn}" Height="34" Padding="14,0" ToolTip="重新扫描系统已安装的软件与各磁盘程序" Click="RefreshButton_Click" />
    </Grid>
    <Border Grid.Row="2" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8">
      <ListView Name="ProgramsListView" BorderThickness="0" Background="#00FFFFFF" SelectionMode="Single" MouseDoubleClick="ProgramsListView_MouseDoubleClick">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <StackPanel Orientation="Horizontal" Margin="6,4" Height="44">
              <Image Width="32" Height="32" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,12,0" Source="{Binding IconSource}" />
              <StackPanel VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                  <TextBlock FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" Text="{Binding Name}" />
                  <Border CornerRadius="3" Padding="5,1" Margin="6,0,0,0" VerticalAlignment="Center" Background="{Binding BadgeBackground}">
                    <TextBlock FontSize="9.5" FontWeight="SemiBold" Text="{Binding TagDisplay}" Foreground="{Binding BadgeForeground}" />
                  </Border>
                </StackPanel>
                <TextBlock FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" Width="380" Margin="0,2,0,0" Text="{Binding FriendlyPath}" />
              </StackPanel>
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ListView>
    </Border>
    <TextBlock Name="StatusTextBlock" Grid.Row="3" Text="正在智能检索系统中已安装的软件与微软商店应用，请稍候..." Foreground="{DynamicResource AccentPrimaryBrush}" Margin="0,6,0,6" FontSize="12" FontWeight="Medium" Visibility="Visible" />
    <Grid Row="4" Margin="0,10,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Button Name="ManualBrowseButton" Grid.Column="0" Content="手动浏览文件..." Style="{StaticResource PickerBtn}" Height="32" Padding="14,0" Click="ManualBrowse_Click" />
      <Button Name="OkButton" Grid.Column="2" Content="确定" Style="{StaticResource PrimaryPickerBtn}" Width="84" Height="32" FontWeight="Bold" Margin="0,0,8,0" Click="Ok_Click" />
      <Button Name="CancelButton" Grid.Column="3" Content="取消" Style="{StaticResource PickerBtn}" Width="84" Height="32" Click="Cancel_Click" />
    </Grid>
  </Grid>
</Window>