<UserControl x:Class="WinPieGestures.StudioProfileIdentity"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <StackPanel>
  <Grid Margin="0,0,0,10">
   <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
   <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
   <Button x:Name="IconButton" Grid.RowSpan="2" Width="34" Height="34" Margin="0,0,8,0" VerticalAlignment="Center"
           Style="{DynamicResource ModernButtonStyle}" Padding="4" Click="IconClick">
    <Grid Width="23" Height="23"><TextBlock x:Name="Fallback" FontSize="18" Foreground="{DynamicResource AccentPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/><Image x:Name="AppImage" Stretch="Uniform"/></Grid>
   </Button>
   <TextBox x:Name="NameEntry" Grid.Column="1" FontSize="17" FontWeight="SemiBold" MinHeight="27" MinWidth="0"
            VerticalContentAlignment="Center" Padding="2,1" KeyDown="CommitOnEnter" TextChanged="DraftChanged">
    <TextBox.Style>
     <Style TargetType="TextBox" BasedOn="{StaticResource ModernTextBoxStyle}">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Style.Triggers>
       <Trigger Property="IsMouseOver" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" /></Trigger>
       <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}" /></Trigger>
      </Style.Triggers>
     </Style>
    </TextBox.Style>
   </TextBox>
   <Border x:Name="GlobalScopeBadge" Grid.Column="2" Margin="5,0,0,0" Padding="5,2" CornerRadius="3" VerticalAlignment="Center"
           Background="{DynamicResource SubtleCardBrush}" Visibility="Collapsed">
    <TextBlock x:Name="GlobalScopeText" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
   </Border>
   <TextBlock x:Name="GlobalHint" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" FontSize="12" Margin="2,0,0,0"
              TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Visibility="Collapsed" />
  </Grid>
  <Grid>
   <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
   <TextBlock x:Name="TagsLabel" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
   <TextBox x:Name="TagsEntry" Grid.Column="1" MinHeight="28" Padding="8,3" VerticalContentAlignment="Center" TextChanged="DraftChanged" KeyDown="CommitOnEnter" />
  </Grid>
  <Button x:Name="Apply" Style="{DynamicResource ModernButtonStyle}" HorizontalAlignment="Right" Margin="0,4,0,0" Padding="9,3" Click="ApplyClick" />
 </StackPanel>
</UserControl>
