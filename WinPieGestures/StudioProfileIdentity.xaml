<UserControl x:Class="WinPieGestures.StudioProfileIdentity"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <StackPanel Margin="4,4,4,8">
  <Button x:Name="IconButton" HorizontalAlignment="Center" Width="54" Height="54" Style="{DynamicResource ModernButtonStyle}" Padding="7" Click="IconClick">
   <Grid Width="36" Height="36"><TextBlock x:Name="Fallback" FontSize="27" Foreground="{DynamicResource AccentPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/><Image x:Name="AppImage" Stretch="Uniform"/></Grid>
  </Button>
  <TextBox x:Name="NameEntry" FontSize="15" FontWeight="SemiBold" HorizontalContentAlignment="Center" Margin="0,7,0,0" Padding="4" KeyDown="CommitOnEnter" TextChanged="DraftChanged"/>
  <TextBlock x:Name="TagsLabel" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,8,0,2"/>
  <TextBox x:Name="TagsEntry" Padding="4" TextChanged="DraftChanged" KeyDown="CommitOnEnter"/>
  <Button x:Name="Apply" Style="{DynamicResource ModernButtonStyle}" HorizontalAlignment="Right" Margin="0,4,0,0" Padding="9,3" Click="ApplyClick"/>
 </StackPanel>
</UserControl>
