<Window x:Class="WinPieGestures.WindowPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="智能运行窗口与进程捕捉器 - StarPie"
        Height="580" Width="520"
        Background="{DynamicResource WindowBackgroundBrush}"
        FontFamily="Segoe UI, Microsoft YaHei"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Loaded="Window_Loaded">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <Style x:Key="PickerBtn" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="{DynamicResource ButtonDefaultBgBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ButtonDefaultBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource ArtBorderThickness}" />
        <Setter Property="Foreground" Value="{DynamicResource ButtonDefaultFgBrush}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource ControlCornerRadius}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter Value="{DynamicResource ButtonHoverBgBrush}" Property="Background" />
                  <Setter Value="{DynamicResource AccentPrimaryBrush}" Property="BorderBrush" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="PrimaryPickerBtn" TargetType="{x:Type Button}" BasedOn="{StaticResource PickerBtn}">
        <Setter Property="Background" Value="{DynamicResource AccentPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource ControlCornerRadius}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter Value="{DynamicResource AccentHoverBrush}" Property="Background" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>

  <Grid Margin="18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- 顶部标题与说明 -->
    <StackPanel Grid.Row="0" Margin="0,0,0,12">
      <TextBlock Name="HeaderTitleText" Text="🎯 捕捉桌面运行中的窗口" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
      <TextBlock Name="HeaderDescText" Text="请按住准星拖至任意目标窗口上方松开，或直接在下方列表中点选。" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,0" />
    </StackPanel>

    <!-- 准星拖拽瞄准卡片 -->
    <Border Grid.Row="1" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource AccentPrimaryBrush}" BorderThickness="1.5" CornerRadius="8" Padding="12" Margin="0,0,0,14">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <!-- 准星图标按钮 -->
        <Border Name="CrosshairTargetBox" Grid.Column="0" Width="46" Height="46" Background="{DynamicResource InputBackgroundBrush}" BorderBrush="{DynamicResource AccentPrimaryBrush}" BorderThickness="1.5" CornerRadius="23" Cursor="Cross" Margin="0,0,14,0" ToolTip="按住鼠标左键不放，拖动准星到桌面上任意目标窗口上方松开即可捕获" PreviewMouseDown="CrosshairTargetBox_PreviewMouseDown">
          <TextBlock Text="🎯" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />
        </Border>
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <TextBlock Text="十字准星拖拽捕捉 (极速瞄准)" FontWeight="SemiBold" FontSize="12.5" Foreground="{DynamicResource AccentPrimaryBrush}" />
          <TextBlock Name="CrosshairStatusText" Text="按住左侧 🎯 准星不松手，拖至屏幕任意窗口上方松开，瞬间捕获！" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" TextWrapping="Wrap" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- 列表搜索栏与刷新按钮 -->
    <Grid Grid.Row="2" Margin="0,0,0,8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Grid Grid.Column="0" Margin="0,0,8,0">
        <TextBox Name="SearchTextBox" Height="32" VerticalContentAlignment="Center" Padding="28,0,10,0" Background="{DynamicResource InputBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1" FontSize="12" TextChanged="SearchTextBox_TextChanged" />
        <TextBlock Text="🔍" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="8,0,0,0" IsHitTestVisible="False" />
        <TextBlock Name="SearchPlaceholderText" Text="快速过滤窗口标题或进程名(如 chrome / code)..." FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Opacity="0.6" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="28,0,0,0" IsHitTestVisible="False" />
      </Grid>
      <Button Name="RefreshButton" Grid.Column="1" Content="🔄 刷新" Style="{StaticResource PickerBtn}" Height="32" Padding="12,0" ToolTip="重新扫描桌面可见活动窗口" Click="RefreshButton_Click" />
    </Grid>

    <!-- 运行中窗口列表 -->
    <Border Grid.Row="3" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8">
      <ListView Name="WindowsListView" BorderThickness="0" Background="Transparent" SelectionMode="Single" MouseDoubleClick="WindowsListView_MouseDoubleClick" SelectionChanged="WindowsListView_SelectionChanged">
        <ListView.ItemTemplate>
          <DataTemplate>
            <Grid Margin="4,4" Height="42">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <!-- 图标 -->
              <Image Grid.Column="0" Width="30" Height="30" Stretch="Uniform" VerticalAlignment="Center" Margin="2,0,12,0" Source="{Binding IconSource}" />
              <!-- 文本信息 -->
              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" Text="{Binding WindowTitle}" />
                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                  <TextBlock FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" FontFamily="Consolas, Segoe UI" Text="{Binding ProcessName}" />
                  <TextBlock FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}" Text=" · " Margin="2,0" />
                  <TextBlock FontSize="10" Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis" MaxWidth="220" Text="{Binding ExecutablePath}" />
                </StackPanel>
              </StackPanel>
              <!-- 捕获微章 -->
              <Border Grid.Column="2" Background="{DynamicResource ButtonDefaultBgBrush}" BorderBrush="{DynamicResource AccentPrimaryBrush}" BorderThickness="1" CornerRadius="4" Padding="6,2" VerticalAlignment="Center" Margin="6,0,4,0">
                <TextBlock Text="点选" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentPrimaryBrush}" />
              </Border>
            </Grid>
          </DataTemplate>
        </ListView.ItemTemplate>
      </ListView>
    </Border>

    <!-- 底部状态说明 -->
    <TextBlock Name="StatusTextBlock" Grid.Row="4" Text="✅ 已自动过滤 StarPie 自身与隐藏后台进程" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,6,0,6" FontSize="11" />

    <!-- 底部按钮操作栏 -->
    <Grid Grid.Row="5" Margin="0,6,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Button Name="OkButton" Grid.Column="1" Content="确定捕获" Style="{StaticResource PrimaryPickerBtn}" Width="92" Height="32" FontWeight="Bold" Margin="0,0,8,0" IsEnabled="False" Click="Ok_Click" />
      <Button Name="CancelButton" Grid.Column="2" Content="取消" Style="{StaticResource PickerBtn}" Width="80" Height="32" Click="Cancel_Click" />
    </Grid>
  </Grid>
</Window>
