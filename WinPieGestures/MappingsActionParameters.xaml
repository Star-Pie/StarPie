<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="WinPieGestures.MappingsActionParameters">
  <Border Background="{DynamicResource SubtleCardBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,10">
    <StackPanel>
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="🔌" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
        <TextBlock Name="FocusPluginTitleText" Text="" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
      </StackPanel>
      <TextBlock Name="FocusPluginDetailText" Text="" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,6,0,0" TextWrapping="Wrap"/>
      <TextBlock Name="FocusPluginParamsHintText" Text="" FontSize="11" Foreground="#D97706" Margin="0,6,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
      <StackPanel Name="FocusPluginParamsPanel" Margin="0,10,0,0" Visibility="Collapsed"/>
      <TextBlock Name="FocusPluginValidationText" Text="" FontSize="11" Foreground="#DC2626" Margin="0,6,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
      <WrapPanel Margin="0,10,0,0">
        <Button Name="ManageButton" Style="{DynamicResource ModernButtonStyle}" Height="28" Padding="10,0"/>
        <Button Name="FocusPluginReloadBtn" Style="{DynamicResource ModernButtonStyle}" Height="28" Padding="10,0" Margin="8,0,0,0"/>
      </WrapPanel>
    </StackPanel>
  </Border>
</UserControl>
