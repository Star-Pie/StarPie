<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="WinPieGestures.ColorPickerWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="色彩选择器与屏幕吸管 (Color Picker)" Icon="app_icon.ico" Height="610" Width="510" MinHeight="560" MinWidth="480" WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip" Background="{DynamicResource WindowBackgroundBrush}" FontFamily="Segoe UI, Microsoft YaHei UI, Arial" xmlns:winpiegestures="clr-namespace:WinPieGestures;assembly=StarPie">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <Style x:Key="ColorSwatchButtonStyle" TargetType="{x:Type Button}">
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Margin" Value="3.5" />
        <Setter Property="FrameworkElement.Cursor" Value="Hand" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Name="border" Background="{TemplateBinding Control.Background}" CornerRadius="5" BorderBrush="#35000000" BorderThickness="1">
                <UIElement.Effect>
                  <DropShadowEffect BlurRadius="2" ShadowDepth="1" Color="#000000" Opacity="0.12" />
                </UIElement.Effect>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="border" Value="{DynamicResource AccentPrimaryBrush}" Property="Border.BorderBrush" />
                  <Setter TargetName="border" Property="Border.BorderThickness" Value="2" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="ModernBtn" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="{DynamicResource ButtonDefaultBgBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ButtonDefaultBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource ArtBorderThickness}" />
        <Setter Property="Foreground" Value="{DynamicResource ButtonDefaultFgBrush}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Padding" Value="14,6" />
        <Setter Property="FrameworkElement.Cursor" Value="Hand" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Background="{TemplateBinding Control.Background}" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}" CornerRadius="{DynamicResource ControlCornerRadius}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Control.Padding}" />
              </Border>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="PrimaryBtn" TargetType="{x:Type Button}" BasedOn="{StaticResource ModernBtn}">
        <Setter Property="Background" Value="{DynamicResource AccentPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid Margin="18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid Row="0" Margin="0,0,0,12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0">
        <TextBlock Text="调色板与屏幕取色" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
        <TextBlock Text="在色盘中精调色彩，或使用屏幕吸管捕获任意像素。" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
        <Border Width="64" Height="36" CornerRadius="{DynamicResource ControlCornerRadius}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="{DynamicResource ArtBorderThickness}" Margin="0,0,8,0">
          <Grid>
            <Border CornerRadius="5" Background="{DynamicResource SubtleCardBrush}" />
            <Border Name="ColorPreviewBorder" CornerRadius="5" />
          </Grid>
        </Border>
        <TextBox Name="HexInputBox" Width="95" Height="36" FontSize="13" FontWeight="SemiBold" Background="{DynamicResource InputBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource InputBorderBrush}" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Margin="0" TextChanged="HexInputBox_TextChanged" />
      </StackPanel>
    </Grid>
    <Grid Row="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="170" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <Border Grid.Row="0" CornerRadius="8" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" ClipToBounds="True">
        <Canvas Name="SpectrumCanvas" Background="#FFFF0000" Cursor="Cross" MouseDown="SpectrumCanvas_MouseDown" MouseMove="SpectrumCanvas_MouseMove">
          <Rectangle Width="{Binding ActualWidth, ElementName=SpectrumCanvas}" Height="{Binding ActualHeight, ElementName=SpectrumCanvas}">
            <Shape.Fill>
              <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="#FFFFFFFF" Offset="0" />
                <GradientStop Color="#00FFFFFF" Offset="1" />
              </LinearGradientBrush>
            </Shape.Fill>
          </Rectangle>
          <Rectangle Width="{Binding ActualWidth, ElementName=SpectrumCanvas}" Height="{Binding ActualHeight, ElementName=SpectrumCanvas}">
            <Shape.Fill>
              <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#00000000" Offset="0" />
                <GradientStop Color="#FF000000" Offset="1" />
              </LinearGradientBrush>
            </Shape.Fill>
          </Rectangle>
          <Ellipse Name="SpectrumThumb" Width="14" Height="14" Stroke="#FFFFFFFF" StrokeThickness="2" Fill="#00FFFFFF" IsHitTestVisible="False" Margin="-7,-7,0,0">
            <UIElement.Effect>
              <DropShadowEffect BlurRadius="4" ShadowDepth="1" Color="#000000" Opacity="0.6" />
            </UIElement.Effect>
          </Ellipse>
        </Canvas>
      </Border>
      <StackPanel Grid.Row="1" Margin="0,8,0,6">
        <Grid Margin="0,0,0,4">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="46" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock Name="HueLabelText" Text="色相" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
          <Slider Name="HueSlider" Grid.Column="1" Minimum="0" Maximum="360" Value="0" Height="18" ValueChanged="HueSlider_ValueChanged">
            <Control.Background>
              <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                <GradientStop Color="#FFFF0000" Offset="0.0" />
                <GradientStop Color="#FFFFFF00" Offset="0.17" />
                <GradientStop Color="#FF00FF00" Offset="0.33" />
                <GradientStop Color="#FF00FFFF" Offset="0.5" />
                <GradientStop Color="#FF0000FF" Offset="0.67" />
                <GradientStop Color="#FFFF00FF" Offset="0.83" />
                <GradientStop Color="#FFFF0000" Offset="1.0" />
              </LinearGradientBrush>
            </Control.Background>
          </Slider>
        </Grid>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="46" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock Name="AlphaLabelText" Text="不透明" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
          <Slider Name="AlphaSlider" Grid.Column="1" Minimum="0" Maximum="255" Value="255" Height="18" ValueChanged="AlphaSlider_ValueChanged" />
        </Grid>
      </StackPanel>
      <Border Grid.Row="2" Background="{DynamicResource SubtleCardBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10,5" Margin="0,0,0,6">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Name="EyedropperTitleText" Text="🔍 屏幕取色吸管" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentPrimaryBrush}" />
            <TextBlock Name="EyedropperDescText" Text="点击后在屏幕任意窗口吸取精准色彩" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" />
          </StackPanel>
          <Button Name="EyedropperButton" Grid.Column="1" Content="从屏幕吸色" Style="{StaticResource PrimaryBtn}" Padding="12,4" Height="26" FontSize="11" Click="Eyedropper_Click" />
        </Grid>
      </Border>
      <Grid Row="3" Margin="0,2,0,0">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Name="SwatchesTitleText" Grid.Row="0" Text="预设经典配色卡 (Quick Swatches - 滚轮滚动查看全部):" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
        <Border Grid.Row="1" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="6">
          <ScrollViewer Name="SwatchesScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PreviewMouseWheel="SwatchesScrollViewer_PreviewMouseWheel">
            <WrapPanel Name="SwatchesPanel" HorizontalAlignment="Center" />
          </ScrollViewer>
        </Border>
      </Grid>
    </Grid>
    <Grid Row="2" Margin="0,10,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Button Name="CancelButton" Grid.Column="1" Content="取消" Style="{StaticResource ModernBtn}" Margin="0,0,8,0" Width="80" Click="Cancel_Click" />
      <Button Name="OkButton" Grid.Column="2" Content="应用色彩" Style="{StaticResource PrimaryBtn}" Width="90" Click="Ok_Click" />
    </Grid>
  </Grid>
</Window>