<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>test_process_launch</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <None Include="..\..\WinPieGestures\App.xaml" Link="HostApp.xaml" CopyToOutputDirectory="PreserveNewest" />
    <Reference Include="StarPie"><HintPath>$(StarPieCandidateDir)\StarPie.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="StarPie.Plugin.Abstractions"><HintPath>$(StarPieCandidateDir)\StarPie.Plugin.Abstractions.dll</HintPath><Private>true</Private></Reference>
    <AssemblyMetadata Include="StarPieCandidateDir" Value="$(StarPieCandidateDir)" />
  </ItemGroup>
  <Target Name="RequireCandidate" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="'$(StarPieCandidateDir)' == '' or !Exists('$(StarPieCandidateDir)\StarPie.dll')" Text="An explicit StarPieCandidateDir with StarPie.dll is required." />
  </Target>
</Project>
