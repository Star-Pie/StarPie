<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>
  <ItemGroup Condition="'$(StarPieCandidateDir)' == ''">
    <ProjectReference Include="..\..\WinPieGestures\WinPieGestures.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(StarPieCandidateDir)' != ''">
    <AssemblyMetadata Include="StarPieCandidateDll" Value="$(StarPieCandidateDir)/StarPie.dll" />
    <Reference Include="StarPie" HintPath="$(StarPieCandidateDir)/StarPie.dll" />
    <Reference Include="StarPie.Plugin.Abstractions" HintPath="$(StarPieCandidateDir)/StarPie.Plugin.Abstractions.dll" />
  </ItemGroup>
</Project>
