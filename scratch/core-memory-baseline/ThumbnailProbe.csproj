<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <AssemblyName>test_process_launch</AssemblyName><EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AssemblySearchPaths>{HintPathFromItem};{RawFileName};{TargetFrameworkDirectory}</AssemblySearchPaths>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="ThumbnailProbe.cs" />
    <Reference Include="StarPie"><HintPath>$(StarPieCandidateDir)/StarPie&#46;dll</HintPath></Reference>
    <Reference Include="StarPie.Plugin.Abstractions"><HintPath>$(StarPieCandidateDir)/StarPie.Plugin.Abstractions.dll</HintPath></Reference>
    <AssemblyMetadata Include="StarPieCandidateDir" Value="$(StarPieCandidateDir)" />
    <AssemblyMetadata Include="ArtifactsRoot" Value="$(ArtifactsRoot)" />
  </ItemGroup>
  <Target Name="RequireCandidate" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="'$(StarPieCandidateDir)' == '' or !Exists('$(StarPieCandidateDir)/StarPie&#46;dll') or '$(ArtifactsRoot)' == ''" Text="Explicit candidate and owned artifact root required." />
  </Target>
</Project>
