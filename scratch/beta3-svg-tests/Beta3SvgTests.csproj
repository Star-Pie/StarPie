<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>test_beta3_svg</AssemblyName>
    <StarPieCandidateDir Condition="'$(StarPieCandidateDir)' == ''"></StarPieCandidateDir>
    <DefineConstants Condition="'$(StarPieCandidateDir)' != ''">$(DefineConstants);STARPIE_CANDIDATE_REFERENCE</DefineConstants>
  </PropertyGroup>

  <ItemGroup Condition="'$(StarPieCandidateDir)' == ''">
    <Compile Include="..\..\WinPieGestures\SvgIconBatchImporter.cs" Link="SvgIconBatchImporter.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(StarPieCandidateDir)' != ''">
    <Reference Include="StarPie">
      <HintPath>$(StarPieCandidateDir)\StarPie.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
</Project>
