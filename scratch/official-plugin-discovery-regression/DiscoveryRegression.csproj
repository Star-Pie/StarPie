<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF><UseWindowsForms>true</UseWindowsForms><Nullable>enable</Nullable>
    <AssemblyName>test_onboarding</AssemblyName><EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../onboarding-download-tests/Program.cs" Link="Program.cs" />
    <Reference Include="StarPie"><HintPath>$(StarPieCandidateDir)/StarPie.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="StarPie.Plugin.Abstractions"><HintPath>$(StarPieCandidateDir)/StarPie.Plugin.Abstractions.dll</HintPath><Private>true</Private></Reference>
  </ItemGroup>
  <Target Name="RequireCandidate" BeforeTargets="ResolveReferences">
    <Error Condition="'$(StarPieCandidateDir)' == '' or !Exists('$(StarPieCandidateDir)/StarPie.dll')" Text="Explicit built candidate required." />
  </Target>
</Project>
