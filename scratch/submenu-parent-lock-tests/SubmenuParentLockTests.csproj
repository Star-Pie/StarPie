<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>test_interaction_events</AssemblyName>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="..\..\WinPieGestures\App.xaml" LogicalName="Fixture.HostStyles.xaml" />
  </ItemGroup>
  <ItemGroup Condition="'$(StarPieCandidateDir)' != ''">
    <Reference Include="StarPie" HintPath="$(StarPieCandidateDir)/StarPie.dll" />
    <Reference Include="StarPie.Plugin.Abstractions" HintPath="$(StarPieCandidateDir)/StarPie.Plugin.Abstractions.dll" />
  </ItemGroup>
  <ItemGroup Condition="'$(StarPieCandidateDir)' == ''">
    <ProjectReference Include="..\..\WinPieGestures\WinPieGestures.csproj" />
  </ItemGroup>
</Project>
