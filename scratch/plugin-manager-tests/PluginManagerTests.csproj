<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Reuse the existing internal catalog-test visibility; no public SDK changes. -->
    <AssemblyName>test_catalog</AssemblyName>
  </PropertyGroup>
  <ItemGroup Condition="'$(StarPieCandidateDir)' == ''">
    <ProjectReference Include="..\..\WinPieGestures\WinPieGestures.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(StarPieCandidateDir)' != ''">
    <Reference Include="StarPie" HintPath="$(StarPieCandidateDir)/StarPie.dll" />
    <Reference Include="StarPie.Plugin.Abstractions" HintPath="$(StarPieCandidateDir)/StarPie.Plugin.Abstractions.dll" />
  </ItemGroup>
</Project>
